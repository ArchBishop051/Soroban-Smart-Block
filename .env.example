# ═══════════════════════════════════════════════════════════════════════════
# Soroban Smart Block Explorer — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

# ── Stellar Network ────────────────────────────────────────────────────────────
# Soroban RPC endpoint (testnet default)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Comma-separated fallback RPC URLs for multi-node resilience
SOROBAN_RPC_URLS=
#vdhv

# Horizon API (for classic asset data)
HORIZON_URL=https://horizon-testnet.stellar.org

# Network passphrase
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Connection string used by the indexer at runtime
# Matches the postgres service credentials in docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5432/soroban_explorer

# Docker Compose will use these to create the database automatically
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=soroban_explorer
POSTGRES_PORT=5432

# ── Indexer ────────────────────────────────────────────────────────────────────
# API server port (default 3001)
PORT=3001

# Start indexing from this ledger number (0 = latest - 100)
START_LEDGER=0

# Poll interval in milliseconds
POLL_MS=5000

# Check for a reorganization every N indexed ledgers
REORG_CHECK_INTERVAL=100

# Maximum supported reorganization depth. Each check stays bounded to the
# configured interval plus this depth (200 stored hashes with the defaults).
REORG_MAX_DEPTH=100

# Deployed explorer contract ID (set after `make deploy`)
EXPLORER_CONTRACT_ID=CDA2ZCIB3ETZNFNQP4NS3SIEW5XCF7DKP5UWN4Y33F5FV34JA2CGAJ44

# API security
API_KEY=
# Comma-separated list of allowed CORS origins (e.g., https://explorer.stellar.org,http://localhost:5173). Set to * for dev mode.
CORS_ORIGINS=*

# GitHub ABI sync
GITHUB_TOKEN=
ABI_REPO=Soroban-Smart-Block-Explorer/verified-abis
ABI_PATH=contracts
ABI_SYNC_CRON=*/10 * * * *

# Seed the built-in ABIs shipped in indexer/src/abis/ (StellarSwap, Blend) on
# startup. Existing registrations are never overwritten. Set to false to disable.
SEED_BUILTIN_ABIS=true

# ── Gas Guzzlers ───────────────────────────────────────────────────────────────
# Interval between gas consumption leaderboard recomputation (ms)
GAS_GUZZLERS_INTERVAL_MS=3600000

# ── Bloat Detection ────────────────────────────────────────────────────────────
# Threshold for flagging high bloat-risk contracts (events per ledger)
BLOAT_THRESHOLD=50

# ── Metadata Cache ─────────────────────────────────────────────────────────────
# Cache TTL for contract metadata lookups (seconds)
METADATA_CACHE_TTL=300

# ─── Simulation ────────────────────────────────────────────────────────────────
# Source account for transaction simulations
SIMULATE_SOURCE=

# ── SAC Assets ─────────────────────────────────────────────────────────────────
# Comma-separated list of Stellar Asset Contract IDs to track
SAC_ASSETS=

# ── Verification ───────────────────────────────────────────────────────────────
# Auto-verify ABI on upload
VERIFY_ON_UPLOAD=true

# ── Redis (optional) ───────────────────────────────────────────────────────────
REDIS_URL=

# ── API Authentication & Rate Limiting ─────────────────────────────────────────
# Bearer token for admin endpoint authentication (POST /api/admin/*)
ADMIN_SECRET=

# Optional TOTP second factor for /api/admin/* (base32). Leave blank to disable.
# When set, clients must also send header X-Admin-TOTP with a current 6-digit code.
# ADMIN_TOTP_SECRET=

# JSON blob overriding default per-tier rate limits
# Example: {"unauthenticated":{"rpm":60,"burst":10},"free":{"rpm":1000,"burst":50}}
RATE_LIMIT_CONFIG=

# Comma-separated ISO-3166-1 alpha-2 country codes to block entirely
# Example: CN,RU,KP
GEO_BLOCK_LIST=

# JSON map of ISO-3166-1 alpha-2 country code → float multiplier applied to base tier limit
# Example: {"CN":0.5,"IN":0.8}
GEO_RATE_MULTIPLIERS=

# Absolute path to a MaxMind GeoLite2-Country.mmdb database file
# Geo-based limiting is skipped (pass-through) when this is unset or the file is absent
GEOIP_DB_PATH=

# Stripe webhook signing secret (from Stripe Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=

# Stripe secret API key used for subscription management
STRIPE_SECRET_KEY=

# Optional Cloudflare DDoS mitigation webhook URL; fired on DDoS pattern detection
CLOUDFLARE_WEBHOOK_URL=

# ── Docker Compose Overrides ───────────────────────────────────────────────────
# Point these to the dev Dockerfiles for hot-reloading:
#   INDEXER_DOCKERFILE=Dockerfile.dev
#   FRONTEND_DOCKERFILE=Dockerfile.dev
#
# Mount source directories for live code changes:
#   FRONTEND_MOUNT=./frontend/src

# Frontend port mapping (default 80 for prod Nginx, 5173 for dev Vite)
FRONTEND_PORT=80

# Adminer port (dev only)
ADMINER_PORT=8080

# PgHero port (dev only)
PGHERO_PORT=8081

# ── Admin Security & Access Control (#982) ──────────────────────────────────
# Comma-separated IPv4/IPv6 addresses allowed to access /api/admin/* endpoints.
# Unset allows requests from any IP provided ADMIN_SECRET is valid.
# ADMIN_IP_ALLOWLIST=

# Bearer token or API key required to access /metrics endpoint. Unset = public metrics.
# METRICS_API_KEY=

# DANGEROUS: Set to true to completely bypass API rate limiting. NEVER set to true in production!
# RATE_LIMITING_DISABLED=false

# Grace period in minutes for retired signing keys during key rotation (default: 60).
# KEY_ROTATION_GRACE_MINUTES=60

# External URL of the admin panel or webhook callback base URL.
# ADMIN_URL=

# ── Indexer Operations & Telemetry (#982) ───────────────────────────────────
# Maximum tolerable lag in seconds between current ledger and indexed ledger (default: 60).
# INDEXER_LAG_THRESHOLD_SECONDS=60

# Unique instance identifier for this indexer node in clustered deployments (default: indexer-1).
# INSTANCE_ID=indexer-1

# Comma-separated list of Kafka broker hosts (e.g., localhost:9092) for event streaming.
# KAFKA_BROKERS=

# Redis key used for distributed leader election lock (default: indexer:leader).
# LEADER_ELECTION_KEY=indexer:leader

# Log level verbosity: debug | info | warn | error (default: info).
# LOG_LEVEL=info

# Target network name: testnet | mainnet | futurenet (default: testnet).
# NETWORK=testnet

# OpenTelemetry OTLP collector gRPC/HTTP endpoint (e.g., http://localhost:4317).
# OTEL_EXPORTER_OTLP_ENDPOINT=

# OpenTelemetry service name for distributed tracing (default: soroban-indexer).
# OTEL_SERVICE_NAME=soroban-indexer

# Enable distributed OpenTelemetry tracing: true | false (default: false).
# OTEL_TRACING_ENABLED=false

# PagerDuty Events API v2 integration / routing key for alerting on critical indexer failures.
# PAGERDUTY_ROUTING_KEY=

# Batch size for historical contract re-decoding worker passes (default: 100).
# REDECODE_BATCH_SIZE=100

# Polling interval in milliseconds between re-decoding worker batches (default: 5000).
# REDECODE_INTERVAL_MS=5000

# Incoming Slack webhook URL for real-time operational alerts and notifications.
# SLACK_WEBHOOK_URL=

# Automatically verify and register ABI schemas on upload: true | false (default: true).
# VERIFY_ABI=true

# Batch size for processing pending contract ABI verification queue (default: 10).
# VERIFY_BATCH_SIZE=10

# Cron expression for background contract ABI verification job (default: */5 * * * *).
# VERIFY_CRON=*/5 * * * *
