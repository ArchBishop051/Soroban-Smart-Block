# Indexer environment — copy this file to .env before running `npm start`
#
#   cp indexer/.env.example indexer/.env
#
# Full variable reference is in the root .env.example

# ── Stellar Network ────────────────────────────────────────────────────────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Matches the postgres service credentials in docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5432/soroban_explorer

# ── Indexer ────────────────────────────────────────────────────────────────────
PORT=3001
START_LEDGER=0
POLL_MS=5000
EXPLORER_CONTRACT_ID=CDA2ZCIB3ETZNFNQP4NS3SIEW5XCF7DKP5UWN4Y33F5FV34JA2CGAJ44

# ── DEX / Lending Protocol Integrations (leave blank to disable decoding) ─────
STELLARSWAP_CONTRACT_ID=
BLEND_CONTRACT_ID=

# ── Auth / Rate limiting (leave blank to disable) ─────────────────────────────
ADMIN_SECRET=
# Optional TOTP second factor for /api/admin/* (base32). Leave blank to disable.
# ADMIN_TOTP_SECRET=
REDIS_URL=

# ── Observability ──────────────────────────────────────────────────────────────
# Sentry DSN for error tracking (leave blank to disable)
SENTRY_DSN=

# ── Email Configuration (for self-service API key creation) ───────────────────
# Choose one: Resend (recommended) or SMTP
# Resend configuration (https://resend.com)
RESEND_API_KEY=

# SMTP configuration (alternative to Resend)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@soroban-explorer.com

# Base URL for verification links (e.g., https://api.example.com)
API_BASE_URL=

# ── Signed API responses (#904) ─────────────────────────────────────────────
# Inject from KMS / Vault at deploy time; never commit or write to disk.
# base64 32-byte Ed25519 seed. Unset = ?signed=1 returns 501.
# EXPLORER_SIGNING_KEY=
# EXPLORER_SIGNING_KEY_ID=
# EXPLORER_SIGNING_KEY_NOT_BEFORE=
# Retired public keys kept published during rotation, JSON array:
# [{"key_id":"...","public_key":"<base64>","not_before":"...","not_after":"..."}]
# EXPLORER_RETIRED_SIGNING_KEYS=

# ── Secrets provider + envelope encryption (#929) ────────────────────────────
# env (default, dev only) | vault
# SECRETS_PROVIDER=env
# VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN=
# VAULT_SECRET_PATH=secret/data/soroban-indexer
# Key-encryption key for DB-stored secrets: base64 of 32 random bytes
#   (openssl rand -base64 32). Unset = stored unencrypted (local dev only).
# SECRETS_KEK=
# Comma-separated previous KEKs, kept until rotation completes.
# SECRETS_KEK_PREVIOUS=

# ── Abuse scoring (#931) ─────────────────────────────────────────────────────
# Shadow mode (score + log only) unless set to true.
# ABUSE_ENFORCE=false
# Comma-separated API-key ids / IPs that are never scored.
# ABUSE_ALLOWLIST=
