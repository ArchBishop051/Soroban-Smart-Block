{
  "name": "Soroban Smart Block Explorer",

  // Build the dev image from .devcontainer/Dockerfile (Rust + wasm32)
  // and compose up postgres as a sidecar. Uses a self-contained compose file so
  // Codespaces doesn't attempt to build the full production stack on startup.
  "dockerComposeFile": "docker-compose.devcontainer.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/Soroban-Smart-Block",
  "overrideCommand": true,
  "remoteUser": "vscode",
  "shutdownAction": "stopCompose",

  // Node 20 via nvm, owned by the vscode user (global npm installs work
  // without sudo). Matches the node-version used in CI.
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },

  "forwardPorts": [5173, 3001, "postgres:5432"],
  "portsAttributes": {
    "5173": { "label": "Frontend", "onAutoForward": "openPreview" },
    "3001": { "label": "Indexer API", "onAutoForward": "silent" },
    "postgres:5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "rust-lang.rust-analyzer",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer" }
      }
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "echo '✅ Container ready. Run: make dev'"
}
